{
  "$description": "PLACEHOLDER tokens for {{name}}. Replace the palette with the brand's real colours (measure the live site or the brand book), keep the role names. Format: W3C DTCG 2025.10. Then run: node scripts/product.mjs tokens",
  "color": {
    "$type": "color",
    "brand": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3098,
          0.2745,
          0.898
        ],
        "hex": "#4f46e5"
      },
      "$description": "PLACEHOLDER: the main brand colour."
    },
    "brand-deep": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1922,
          0.1804,
          0.5059
        ],
        "hex": "#312e81"
      },
      "$description": "PLACEHOLDER: a darker shade for text and dark panels."
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0941,
          0.1529
        ],
        "hex": "#111827"
      },
      "$description": "PLACEHOLDER: text colour."
    },
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
