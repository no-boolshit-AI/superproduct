        "hex": "#4b5563"
      },
      "$description": "PLACEHOLDER: secondary text."
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.9059,
          0.9216
        ],
        "hex": "#e5e7eb"
      },
      "$description": "PLACEHOLDER: borders."
    },
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "role": {
      "$description": "Semantic roles. Agents read these; keep the names.",
      "primary": {
        "$value": "{color.brand}"
      },
      "on-primary": {
        "$value": "{color.white}"
      },
      "secondary": {
        "$value": "{color.brand-deep}"
      },
      "accent": {
        "$value": "{color.brand}"
      },
      "on-accent": {
        "$value": "{color.white}"
      },
      "accent-text": {
        "$value": "{color.brand}"
      },
      "background": {
        "$value": "{color.paper}"
      },
      "surface": {
        "$value": "{color.mist}"
      },
      "text": {
        "$value": "{color.ink}"
      },
      "text-muted": {
        "$value": "{color.grey}"
      },
      "text-subtle": {
        "$value": "{color.grey}"
      },
      "inverse": {
        "$value": "{color.ink}"
      },
      "on-inverse": {
        "$value": "{color.white}"
      },
      "border": {
        "$value": "{color.line}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "PLACEHOLDER: body and UI face."
      },
      "serif": {
        "$value": [
          "Source Serif 4",
          "ui-serif",
          "Georgia",
          "serif"
        ],
        "$description": "PLACEHOLDER: accent or heading face."
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "container": {
      "$value": {
        "value": 1200,
        "unit": "px"
      }
    }
  }
