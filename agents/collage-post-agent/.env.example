# --- required ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- optional ---
# Product folder (palette, fonts, masthead, voice, facts) shared by all agents. Empty = the nearest product/ folder;
# "none" = no product folder. With a product folder, its wordmark and "brand" palette replace BRAND_NAME and PALETTE.
PRODUCT_DIR=
# Masthead on every slide (without a product folder)
BRAND_NAME=Your Brand
# Claude model for the agent: opus, sonnet, or a full model id
AGENT_MODEL=opus
# gpt-image-2.5-flare (fast) or gpt-image-2.5-sunburst (most capable)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high | xhigh | max
OPENAI_IMAGE_QUALITY=medium
# Generated images per post (Wikimedia downloads don't count)
MAX_IMAGES=10
# auto, or one of: orchid cobalt acid ember ultraviolet verdigris saffron newsprint graphite (brand: the product's)
PALETTE=auto
# auto, or a number of slides
SLIDES=auto
# 1 = 1080x1350 PNGs, 2 = 2160x2700
EXPORT_SCALE=1
# Hard stop for Claude spend per run (USD)
MAX_BUDGET_USD=6
# 1 = also allow CC BY / CC BY-SA photos from Wikimedia (credits go to CREDITS.md)
ALLOW_CC_BY=0
# Your email or website, sent in the User-Agent as Wikimedia's API policy asks
WIKIMEDIA_CONTACT=
# Web UI port
PORT=4747
# Where posts are written (default ./output)
# OUTPUT_DIR=
