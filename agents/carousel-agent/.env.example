# Claude auth (pick ONE; leave the others empty):
#  a) Your Claude subscription, nothing to set: run on a machine where Claude Code is logged in (`claude`, then /login).
#  b) Your Claude subscription as a token (servers, CI, containers): run `claude setup-token` and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
#  c) Pay-as-you-go API key (takes precedence over the subscription if set).
ANTHROPIC_API_KEY=
# Optional: pin the Claude model (IDs: https://docs.claude.com/en/docs/about-claude/models). Empty = SDK default.
CLAUDE_MODEL=
# Optional: hard stop on Claude spend per run (USD)
MAX_BUDGET_USD=5

# OpenAI images. Without a key the agent runs with offline mock imagery.
OPENAI_API_KEY=
# gpt-image-2.5-flare (fast, default) | gpt-image-2.5-sunburst (finer detail, slower) | gpt-image-2 | gpt-image-1.5 ...
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Force mock images even when a key is set (layout iteration without image cost)
IMAGE_MOCK=0

# Export resolution multiplier: 2 → 2160px wide PNGs
EXPORT_SCALE=2
# Product folder (brand, voice, facts) shared by all agents. Empty = the workspace's product/ (../../workspace/product);
# "none" = no product folder. --product on the command line wins.
PRODUCT_DIR=
# Where runs go. Empty = the workspace's out/carousel (../../workspace/out/carousel). --out wins.
OUTPUT_DIR=
# Brand file used when there is no product folder. --brand wins over both.
BRAND_FILE=
# Only if Playwright's bundled Chromium is unavailable
CHROMIUM_PATH=
