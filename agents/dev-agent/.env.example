# ---------------------------------------------------------------- Claude auth (pick one)
# Pay-as-you-go API key
ANTHROPIC_API_KEY=
# …or your Claude subscription: run `claude setup-token` once and paste the token here.
# (Containers can't read your Mac's keychain login, so the token is needed for docker runs.)
# CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------- GitHub
# Fine-grained personal access token for the repos the agent works on:
#   Contents: read & write · Pull requests: read & write · Metadata: read
# Leave empty to fall back to `gh auth token` (GitHub CLI) or to your SSH keys for git@ URLs.
GITHUB_TOKEN=

# ---------------------------------------------------------------- Defaults (projects can override in setup)
# Claude model: opus, sonnet, or a full model id
AGENT_MODEL=opus
# Hard stop for Claude spend per run (USD) and per project setup
MAX_BUDGET_USD=30
SETUP_BUDGET_USD=8
# docker (each run gets its own container + services) | local (runs commands on this machine, no isolation)
RUNTIME=docker
# Web UI port
PORT=4949
# Where projects/, runs/, cache/ and ask/ live (default: the workspace's dev/, ../../workspace/dev)
# DEVAGENT_HOME=
# Minutes before a single verify/bootstrap command is killed
COMMAND_TIMEOUT_MIN=20
# Default for new projects (the setup interview asks): pause for approval after PRD + plan (1) or run fully autonomous (0)
APPROVE_PLAN=0
# Commit author for the agent's commits (the setup interview can override per project)
# DEVAGENT_AUTHOR_NAME=dev-agent
# DEVAGENT_AUTHOR_EMAIL=dev-agent@users.noreply.github.com
# Optional: higher rate limits for the Context7 docs MCP server
# CONTEXT7_API_KEY=

# Product folder (terms, voice, design tokens) shared by all agents. dev-agent uses it only for repositories listed in
# its product.json → repos, unless a project's profile or --product names it. Empty = the workspace's product/; "none" = off.
PRODUCT_DIR=
