# ── Claude auth (pick ONE; leave the others empty) ───────────────────────────────
#  a) Your Claude subscription, nothing to set: run where Claude Code is logged in (`claude`, then /login).
#  b) Your Claude subscription as a token (servers, CI, containers): `claude setup-token`, paste here.
CLAUDE_CODE_OAUTH_TOKEN=
#  c) Pay-as-you-go API key (takes precedence over the subscription if set).
ANTHROPIC_API_KEY=
# Optional: pin the Claude model (https://docs.claude.com/en/docs/about-claude/models). Empty = SDK default.
CLAUDE_MODEL=
# Hard stop on Claude spend per run (USD) and on agent turns
MAX_BUDGET_USD=8
MAX_TURNS=160

# ── Output ─────────────────────────────────────────────────────────────────────
# Resolution of the page PNGs that go into the PDF (200 = sharp on screen and fine for office printing; 300 = print shop)
EXPORT_DPI=200
# Hidden text layer in the PDF so it can be searched / copied (1) or pure image pages (0)
PDF_TEXT_LAYER=1
# Product folder (brand, voice, facts) shared by all agents. Empty = the nearest product/ folder above this agent;
# "none" = no product folder. --product on the command line wins.
PRODUCT_DIR=
# Brand file used when there is no product folder (logo, wordmark, colours, fonts). --brand wins over both.
BRAND_FILE=

# ── Images (optional) ──────────────────────────────────────────────────────────
# Without a key the agent works with charts, diagrams, icons and your own files only.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# 1 = placeholder art instead of real image generation (layout iteration without cost)
IMAGE_MOCK=0
MAX_IMAGES=6

# ── Rendering ──────────────────────────────────────────────────────────────────
# Only if Playwright's bundled Chromium is unavailable (e.g. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome)
CHROMIUM_PATH=

# ── Web UI ─────────────────────────────────────────────────────────────────────
PORT=4848
MAX_UI_BUDGET_USD=25
