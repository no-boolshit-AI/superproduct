# ── Claude auth (pick ONE; leave the others empty) ───────────────────────────────
#  a) Your Claude subscription, nothing to set: run where Claude Code is logged in (`claude`, then /login).
#  b) Your Claude subscription as a token (servers, CI, containers): `claude setup-token`, paste here.
CLAUDE_CODE_OAUTH_TOKEN=
#  c) Pay-as-you-go API key (takes precedence over the subscription if set).
ANTHROPIC_API_KEY=
# Optional: pin the Claude model (https://docs.claude.com/en/docs/about-claude/models). Empty = SDK default.
CLAUDE_MODEL=
# Optional: reasoning effort for the main agent: low | medium | high | xhigh | max. Empty = the model's default.
CLAUDE_EFFORT=
# The frame workers (one per frame, in parallel): a cheaper/faster model if you like. Empty = same as the main agent.
FRAME_WORKER_MODEL=
FRAME_WORKER_EFFORT=
# Hard stop on Claude spend per video (USD) and on agent turns. A 45-second explainer usually needs 30–80 turns.
MAX_BUDGET_USD=15
MAX_TURNS=400

# ── Video defaults ───────────────────────────────────────────────────────────────
# portrait (1080×1350, 4:5 · LinkedIn/Instagram feed) | vertical (9:16) | square (1:1) | landscape (16:9)
DEFAULT_FORMAT=portrait
# Visual style when neither --style nor product.json → agents.explainer.style names one:
# editorial (cinematic cut-outs on brand colour, the default) | vox-collage | default (a HyperFrames preset)
# DEFAULT_STYLE=editorial
# Storyboard first: a run stops at a storyboard to approve (npm run video -- --approve <job-id>). off = build in one go.
# STORYBOARD=on
# Target length in seconds (the storyboard and, with --voice, the narration decide the exact length)
DEFAULT_LENGTH_SEC=45
# Product folder (brand, voice, facts) shared by all agents. Empty = the workspace's product/ (../../workspace/product);
# "none" = no product folder (HyperFrames preset palette). --product on the command line wins.
PRODUCT_DIR=
# Where jobs are written. Empty = the workspace's out/explainer (../../workspace/out/explainer).
OUTPUT_DIR=

# ── Generated pictures (optional) ────────────────────────────────────────────────
# OpenAI GPT Image makes pictures for the motion layers (cut-outs, illustrated interface elements, illustrations,
# scenes) in the product's illustration style: product.json → agents.explainer.images (a style description and
# reference illustrations), else brand.imageStyle. Without a key the agent draws in HTML/SVG only; --no-images turns
# it off for one run.
OPENAI_API_KEY=
# gpt-image-2.5-flare (fast, default) | gpt-image-2.5-sunburst (finer detail, slower) | gpt-image-2 | gpt-image-1.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high | xhigh | max (xhigh and max: gpt-image-2.5 only)
OPENAI_IMAGE_QUALITY=high
# New pictures per run (an identical request reuses the earlier file for free)
MAX_IMAGES=24
# 1 = placeholder pictures instead of real ones (layout iteration and tests, no image cost)
IMAGE_MOCK=0

# ── Narration, music and sound effects (optional) ────────────────────────────────
# ElevenLabs, called by the agent itself: narration with exact word timings (--voice), a composed music bed
# (--music auto or --music "<mood>") and sound effects made for the video (--sfx).
ELEVENLABS_API_KEY=
# Default narration voice (an ElevenLabs voice id; --voice-id and product.json → agents.explainer.voice win).
# Empty = George (JBFqnCBsd6RMkjVDRZzb), a warm British narrator from ElevenLabs' default library.
ELEVENLABS_VOICE_ID=
# Empty = eleven_multilingual_v2 · or eleven_v4, eleven_v3, eleven_flash_v2_5
ELEVENLABS_TTS_MODEL=
# Empty = music_v2_5 · or music_v2, music_v1
ELEVENLABS_MUSIC_MODEL=
# A regional server, e.g. https://api.eu.residency.elevenlabs.io (empty = https://api.elevenlabs.io)
ELEVENLABS_BASE_URL=
# Without ElevenLabs, --voice uses HyperFrames' own chain: HeyGen (word timings) → the free local Kokoro voice
# (npm run setup:voice). `npx hyperframes auth login` also works for HeyGen instead of a key.
HEYGEN_API_KEY=
# hyperframes = narrate through that chain even when ELEVENLABS_API_KEY is set
VOICE_PROVIDER=

# ── HyperFrames ──────────────────────────────────────────────────────────────────
# Only if the Chrome that `npm run setup` downloads can't be used: a Chrome/Chromium executable.
HYPERFRAMES_BROWSER_PATH=
# Python for the local voice. Empty = ./.venv (created by npm run setup:voice), else python3.
HYPERFRAMES_PYTHON=

# ── Web UI ─────────────────────────────────────────────────────────────────────
PORT=5050
MAX_UI_BUDGET_USD=30
