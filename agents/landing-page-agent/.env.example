# Authentication: pick ONE.
#
# a) Your Claude subscription (Pro, Max, Team, Enterprise). Usage counts against your plan limits.
#    Easiest: log in once with Claude Code (`claude`, then /login) and leave everything below commented out.
#    Or run `claude setup-token` and paste the token here:
# CLAUDE_CODE_OAUTH_TOKEN=
#
# b) Pay-as-you-go API key from https://platform.claude.com (takes precedence over the subscription if set):
# ANTHROPIC_API_KEY=

# Optional
LPA_MODEL=opus
LPA_MAX_BUDGET_USD=8
LPA_MAX_TURNS=120
LPA_REVIEW_ROUNDS=2
LPA_PORT=8787
LPA_API_TOKEN=
LPA_CONCURRENCY=1
# LPA_CHROMIUM_PATH=/path/to/chrome
# LPA_DENYLIST=competitor-name,another-term
# Where pages are generated, with the packages they build with. Empty = the workspace's sites/ (../../workspace/sites).
# LPA_SITES_DIR=
# Product folder (brand, voice, facts) shared by all agents. Empty = the workspace's product/ (../../workspace/product);
# "none" = no product folder. -p/--product on the command line wins.
# PRODUCT_DIR=
