{
  "name": "landing-page-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Agent SDK agent that builds brand-themed Next.js + Tailwind landing pages with the Corporate Landing design system.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "setup": "npm install --prefix sites --no-audit --no-fund && npx playwright install chromium",
    "page": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "check": "tsx src/cli.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "gallery": "tsx src/gallery.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
