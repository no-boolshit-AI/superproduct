{
  "$description": "Corporate Landing design tokens. Source of truth: tokens.css. Brand tokens (brand-*, second-*, accent*, inverse, font families, heading weight, radii) are neutral defaults overridden per site by styles/brand.css (generated by set_brand).",
  "breakpoint": {
    "sm": "40rem",
    "md": "48rem",
    "lg": "64rem",
    "xl": "80rem"
  },
  "color": {
    "neutral": {
      "white": "#ffffff",
      "black": "#000000",
      "canvas": "#ffffff",
      "surface": "#f6f6f4",
      "subtle": "#ededea",
      "line": "#e2e2de",
      "line-strong": "#c9c9c3",
      "ink": "#16171a",
      "ink-soft": "#33353b",
      "muted": "#5f626a",
      "faint": "#8e9198"
    },
    "brand (default, replaced by set_brand)": {
      "brand-50": "#f5f5f6",
      "brand-100": "#e9e9eb",
      "brand-200": "#d3d4d8",
      "brand-300": "#b3b5bb",
      "brand-400": "#8b8e96",
      "brand-500": "#6c6f78",
      "brand-600": "#54575f",
      "brand-700": "#43464d",
      "brand-800": "#34363c",
      "brand-900": "#26282c",
      "brand-950": "#17181b"
    },
    "second (default, replaced by set_brand)": {
      "second-50": "#f6f5f3",
      "second-100": "#ebe8e3",
      "second-200": "#d8d2c8",
      "second-300": "#bdb3a4",
      "second-400": "#9e917e",
      "second-500": "#837562",
      "second-600": "#6b5f4f",
      "second-700": "#564c40",
      "second-800": "#423a31",
      "second-900": "#2f2a24"
    },
    "accent": {
      "accent": "var(--color-brand-600)",
      "accent-hover": "var(--color-brand-700)",
      "accent-soft": "var(--color-brand-50)",
      "accent-line": "var(--color-brand-200)",
      "accent-text": "var(--color-brand-700)",
      "on-accent": "#ffffff"
    },
    "inverse": {
      "inverse": "var(--color-brand-950)",
      "inverse-raised": "rgb(255 255 255 / 0.06)",
      "inverse-line": "rgb(255 255 255 / 0.14)",
      "on-inverse": "#ffffff",
      "on-inverse-muted": "rgb(255 255 255 / 0.72)",
      "on-inverse-faint": "rgb(255 255 255 / 0.48)"
    },
    "semantic (tone-aware)": {
      "fg": "var(--color-ink)",
      "fg-soft": "var(--color-ink-soft)",
      "fg-muted": "var(--color-muted)",
      "fg-faint": "var(--color-faint)",
      "border": "var(--color-line)",
      "border-strong": "var(--color-line-strong)",
      "card": "var(--color-canvas)",
      "card-soft": "var(--color-surface)",
      "link": "var(--color-accent-text)"
    },
    "status": {
      "success": "#17804a",
      "success-soft": "#e6f4ec",
      "warning": "#a65f00",
      "warning-soft": "#fdf1df",
      "danger": "#be2d2d",
      "danger-soft": "#fbe9e9"
    }
  },
  "font": {
    "sans": "var(--font-body-family, \"Inter Variable\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "display": "var(--font-display-family, var(--font-body-family, \"Inter Variable\")), ui-sans-serif, system-ui, sans-serif",
    "accent": "var(--font-accent-family, var(--font-display-family, \"Inter Variable\")), ui-serif, Georgia, serif",
    "mono": "\"JetBrains Mono Variable\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "available (set_brand)": [
      "inter",
      "manrope",
      "dm-sans",
      "plus-jakarta-sans",
      "space-grotesk",
      "ibm-plex-sans",
      "outfit",
      "instrument-sans",
      "fraunces",
      "source-serif-4",
      "crimson-pro"
    ]
  },
  "fontWeight": {
    "normal": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },
  "text": {
    "hero": {
      "size": "4.5rem",
      "line-height": "1.02",
      "letter-spacing": "-0.035em",
      "font-weight": "var(--heading-weight, 600)"
    },
    "display": {
      "size": "3.5rem",
      "line-height": "1.05",
      "letter-spacing": "-0.03em",
      "font-weight": "var(--heading-weight, 600)"
    },
    "title": {
      "size": "2.5rem",
      "line-height": "1.1",
      "letter-spacing": "-0.025em",
      "font-weight": "var(--heading-weight, 600)"
    },
    "heading": {
      "size": "1.75rem",
      "line-height": "1.2",
      "letter-spacing": "-0.02em",
      "font-weight": "var(--heading-weight, 600)"
    },
    "subheading": {
      "size": "1.25rem",
      "line-height": "1.35",
      "letter-spacing": "-0.01em",
      "font-weight": "var(--heading-weight, 600)"
    },
    "lead": {
      "size": "1.25rem",
      "line-height": "1.55",
      "font-weight": "400"
    },
    "body": {
      "size": "1.0625rem",
      "line-height": "1.6",
      "font-weight": "400"
    },
    "label": {
      "size": "0.9375rem",
      "line-height": "1.3",
      "font-weight": "500"
    },
    "small": {
      "size": "0.875rem",
      "line-height": "1.5",
      "font-weight": "400"
    },
    "kicker": {
      "size": "0.8125rem",
      "line-height": "1.2",
      "letter-spacing": "0.08em",
      "font-weight": "600"
    },
    "micro": {
      "size": "0.75rem",
      "line-height": "1.4",
      "font-weight": "500"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "button": "10px",
    "full": "9999px",
    "roundness presets (set_brand)": {
      "sharp": {
        "sm": 2,
        "md": 4,
        "lg": 6,
        "xl": 10,
        "button": 4
      },
      "soft": {
        "sm": 6,
        "md": 10,
        "lg": 16,
        "xl": 24,
        "button": 10
      },
      "round": {
        "sm": 10,
        "md": 16,
        "lg": 24,
        "xl": 32,
        "button": "pill"
      }
    }
  },
  "shadow": {
    "sm": "0 1px 2px rgb(22 23 26 / 0.06), 0 1px 1px rgb(22 23 26 / 0.04)",
    "md": "0 6px 16px -4px rgb(22 23 26 / 0.1), 0 2px 4px -2px rgb(22 23 26 / 0.06)",
    "lg": "0 28px 56px -16px rgb(22 23 26 / 0.22), 0 8px 16px -8px rgb(22 23 26 / 0.08)",
    "brand": "0 18px 40px -12px color-mix(in oklab, var(--color-accent) 45%, transparent)"
  },
  "container": {
    "page": "76rem",
    "wide": "86rem",
    "narrow": "48rem",
    "prose": "42rem",
    "lede": "38rem",
    "headline": "52rem",
    "_note": "container-page/wide/narrow utilities centre content (margin-inline:auto) with 20px/32px side padding."
  },
  "spacing": {
    "section-y": "72px mobile / 112px desktop",
    "section-y-tight": "48px / 72px",
    "section-gap": "40px / 64px"
  },
  "ease": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "out": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}