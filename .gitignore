# What stays out of the public superproduct repository.

# Your product and your work live in the workspace: its own (private) git repository, never part of this one.
# See templates/workspace/README.md; never send its contents in a pull request.
/workspace/

# Where they lived before the workspace (node scripts/workspace.mjs migrate moves them into it)
/product/
/products/
/products-archive/
/briefs/

# Secrets
.env
.env.*
!.env.example
secrets.env

# Dependencies, builds and local tooling (agent outputs are ignored in each agent's own .gitignore)
node_modules/
*.tsbuildinfo
/.claude/
.DS_Store
*.log
*.tgz
